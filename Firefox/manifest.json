{
  "manifest_version": 2,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "2.0.3",
  "permissions": ["activeTab", "tabs", "storage"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_icon": "lookup-wcag-scs.png",
    "default_title": "__MSG_actionTitle__"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["i18n.js", "data-source.js", "lookup-functions.js"]
    }
  ]
}
